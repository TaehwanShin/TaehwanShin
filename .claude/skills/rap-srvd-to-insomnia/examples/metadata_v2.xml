<?xml version="1.0" encoding="utf-8"?>
<!-- Hand-written sample in the shape RAP generates for ZUI_TRAVEL_O2 (OData V2), for tests only. -->
<edmx:Edmx Version="1.0" xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx" xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata" xmlns:sap="http://www.sap.com/Protocols/SAPData">
  <edmx:DataServices m:DataServiceVersion="2.0">
    <Schema Namespace="cds_zui_travel" xmlns="http://schemas.microsoft.com/ado/2008/09/edm">
      <EntityType Name="TravelType" sap:label="Travel">
        <Key><PropertyRef Name="TravelUUID"/><PropertyRef Name="IsActiveEntity"/></Key>
        <Property Name="TravelUUID" Type="Edm.Guid" Nullable="false" sap:creatable="false" sap:updatable="false"/>
        <Property Name="TravelID" Type="Edm.String" MaxLength="8" sap:creatable="false" sap:updatable="false"/>
        <Property Name="AgencyID" Type="Edm.String" MaxLength="6"/>
        <Property Name="CustomerID" Type="Edm.String" MaxLength="6"/>
        <Property Name="BeginDate" Type="Edm.DateTime" Precision="0" sap:display-format="Date"/>
        <Property Name="EndDate" Type="Edm.DateTime" Precision="0" sap:display-format="Date"/>
        <Property Name="TotalPrice" Type="Edm.Decimal" Precision="16" Scale="3" sap:creatable="false" sap:updatable="false"/>
        <Property Name="CurrencyCode" Type="Edm.String" MaxLength="5" sap:updatable="false"/>
        <Property Name="OverallStatus" Type="Edm.String" MaxLength="1" sap:creatable="false" sap:updatable="false"/>
        <Property Name="IsActiveEntity" Type="Edm.Boolean" Nullable="false" sap:creatable="false" sap:updatable="false"/>
        <NavigationProperty Name="to_Booking" Relationship="cds_zui_travel.assoc_Travel_Booking" FromRole="FromRole_assoc_Travel_Booking" ToRole="ToRole_assoc_Travel_Booking"/>
      </EntityType>
      <EntityType Name="BookingType">
        <Key><PropertyRef Name="BookingUUID"/><PropertyRef Name="IsActiveEntity"/></Key>
        <Property Name="BookingUUID" Type="Edm.Guid" Nullable="false" sap:creatable="false" sap:updatable="false"/>
        <Property Name="TravelUUID" Type="Edm.Guid" sap:creatable="false" sap:updatable="false"/>
        <Property Name="BookingID" Type="Edm.String" MaxLength="4" sap:creatable="false" sap:updatable="false"/>
        <Property Name="FlightPrice" Type="Edm.Decimal" Precision="16" Scale="3"/>
        <Property Name="CurrencyCode" Type="Edm.String" MaxLength="5"/>
        <Property Name="IsActiveEntity" Type="Edm.Boolean" Nullable="false" sap:creatable="false" sap:updatable="false"/>
      </EntityType>
      <EntityType Name="AgencyType">
        <Key><PropertyRef Name="AgencyID"/></Key>
        <Property Name="AgencyID" Type="Edm.String" Nullable="false" MaxLength="6"/>
        <Property Name="Name" Type="Edm.String" MaxLength="80"/>
      </EntityType>
      <Association Name="assoc_Travel_Booking">
        <End Type="cds_zui_travel.TravelType" Multiplicity="1" Role="FromRole_assoc_Travel_Booking"/>
        <End Type="cds_zui_travel.BookingType" Multiplicity="*" Role="ToRole_assoc_Travel_Booking"/>
      </Association>
      <EntityContainer Name="cds_zui_travel_Entities" m:IsDefaultEntityContainer="true">
        <EntitySet Name="Travel" EntityType="cds_zui_travel.TravelType"/>
        <EntitySet Name="Booking" EntityType="cds_zui_travel.BookingType"/>
        <EntitySet Name="Agency" EntityType="cds_zui_travel.AgencyType"/>
        <FunctionImport Name="acceptTravel" ReturnType="cds_zui_travel.TravelType" EntitySet="Travel" m:HttpMethod="POST" sap:action-for="cds_zui_travel.TravelType">
          <Parameter Name="TravelUUID" Type="Edm.Guid" Mode="In"/>
          <Parameter Name="IsActiveEntity" Type="Edm.Boolean" Mode="In"/>
        </FunctionImport>
        <FunctionImport Name="rejectTravel" ReturnType="cds_zui_travel.TravelType" EntitySet="Travel" m:HttpMethod="POST" sap:action-for="cds_zui_travel.TravelType">
          <Parameter Name="TravelUUID" Type="Edm.Guid" Mode="In"/>
          <Parameter Name="IsActiveEntity" Type="Edm.Boolean" Mode="In"/>
        </FunctionImport>
        <FunctionImport Name="deductDiscount" ReturnType="cds_zui_travel.TravelType" EntitySet="Travel" m:HttpMethod="POST" sap:action-for="cds_zui_travel.TravelType">
          <Parameter Name="TravelUUID" Type="Edm.Guid" Mode="In"/>
          <Parameter Name="IsActiveEntity" Type="Edm.Boolean" Mode="In"/>
          <Parameter Name="discount_percent" Type="Edm.Byte" Mode="In"/>
        </FunctionImport>
        <FunctionImport Name="TravelEdit" ReturnType="cds_zui_travel.TravelType" EntitySet="Travel" m:HttpMethod="POST" sap:action-for="cds_zui_travel.TravelType">
          <Parameter Name="TravelUUID" Type="Edm.Guid" Mode="In"/>
          <Parameter Name="IsActiveEntity" Type="Edm.Boolean" Mode="In"/>
          <Parameter Name="PreserveChanges" Type="Edm.Boolean" Mode="In"/>
        </FunctionImport>
        <FunctionImport Name="TravelActivate" ReturnType="cds_zui_travel.TravelType" EntitySet="Travel" m:HttpMethod="POST" sap:action-for="cds_zui_travel.TravelType">
          <Parameter Name="TravelUUID" Type="Edm.Guid" Mode="In"/>
          <Parameter Name="IsActiveEntity" Type="Edm.Boolean" Mode="In"/>
        </FunctionImport>
        <FunctionImport Name="TravelPrepare" ReturnType="cds_zui_travel.TravelType" EntitySet="Travel" m:HttpMethod="POST" sap:action-for="cds_zui_travel.TravelType">
          <Parameter Name="TravelUUID" Type="Edm.Guid" Mode="In"/>
          <Parameter Name="IsActiveEntity" Type="Edm.Boolean" Mode="In"/>
        </FunctionImport>
      </EntityContainer>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
