managed implementation in class zbp_i_travel unique;
strict ( 2 );

// Root BO. 모든 action 은 여기에 정의하고, Web API 별 노출은 projection BDEF 의 use action 으로 고른다.
define behavior for ZI_Travel alias Travel
persistent table ztravel
lock master
authorization master ( instance )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;

  field ( numbering : managed, readonly ) TravelUUID;
  field ( readonly ) TravelID, OverallStatus, TotalPrice, LocalLastChangedAt;
  field ( mandatory ) AgencyID, CustomerID, BeginDate, EndDate;

  action acceptTravel result [1] $self;
  action rejectTravel result [1] $self;
  action deductDiscount parameter ZA_Discount result [1] $self;
}
